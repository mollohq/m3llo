import { Theme } from "../theme.slint";
import { H2hPerson, BeltReveal, FeedCardData } from "../types.slint";
import { SealedFixtures } from "./sealed_fixtures.slint";
import { Clock, SealedUi } from "../components/sealed.slint";
import { CrewFeed } from "../panels/crew_feed.slint";
import { ControlBar } from "../panels/control_bar.slint";
import { ZonesData } from "../components/feed_board.slint";

// ============================================================
//  The weekly recap in the centre view (SEALED-REVEAL.md section 3), on a
//  manual clock, over the Monday feed. At rest it is the two-column card.
//
//    slint-viewer --component PreviewRevealRecap --screenshot out.png \
//      client/ui/previews/recap_reveal_preview.slint
//
//  The software renderer of `--screenshot` draws no transform: the card shows
//  at its layout size (508 by 360), not at the scale of the centre view.
// ============================================================

global P {
    out property <H2hPerson> bob: { id: "u-bob", name: "b0bben", initials: "B0", hue-index: 1, avatar: @image-url("fixtures/avatars/b0bben.svg"), has-avatar: true };
    out property <H2hPerson> max: { id: "u-max", name: "Max", initials: "MA", hue-index: 0, avatar: @image-url("fixtures/avatars/max.svg"), has-avatar: true };
    out property <H2hPerson> jonas: { id: "u-jonas", name: "Jonas", initials: "JO", hue-index: 2, avatar: @image-url("fixtures/avatars/jonas.svg"), has-avatar: true };
    out property <H2hPerson> sara: { id: "u-sara", name: "Sara", initials: "SA", hue-index: 3, avatar: @image-url("fixtures/avatars/sara.svg"), has-avatar: true };
    out property <H2hPerson> leo: { id: "u-leo", name: "Leo", initials: "LE", hue-index: 4, avatar: @image-url("fixtures/avatars/leo.svg"), has-avatar: true };
    out property <H2hPerson> hugo: { id: "u-hugo", name: "Hugo", initials: "HU", hue-index: 2, avatar: @image-url("fixtures/avatars/hugo.svg"), has-avatar: true };

    out property <image> cs2: @image-url("fixtures/capsule-sample-1.png");
    out property <image> rl: @image-url("fixtures/capsule-sample-2.png");
    out property <image> drg: @image-url("fixtures/capsule-sample-4.png");
    out property <image> hd2: @image-url("fixtures/capsule-sample-5.png");
    out property <image> i-carry: @image-url("../icons/h2h-carry.svg");
    out property <image> i-owl: @image-url("../icons/h2h-night-owl.svg");
    out property <image> i-marathon: @image-url("../icons/h2h-belt.svg");

    out property <BeltReveal> marathon: {
        key: "marathon:911", sealed: false, seed: 911,
        code: SealedFixtures.marathon-code, cells: SealedFixtures.marathon-cells,
        title: "Marathon", icon: P.i-marathon, hue-index: P.sara.hue-index, kind: 1, amount: 232,
        stat: "Longest single game session.", holder: P.sara, prev: P.leo,
    };
    out property <BeltReveal> carry: {
        key: "the_carry:1307", sealed: false, seed: 1307,
        code: SealedFixtures.carry-code, cells: SealedFixtures.carry-cells,
        title: "The Carry", icon: P.i-carry, hue-index: P.leo.hue-index, kind: 0, amount: 412, unit: "h",
        stat: "Most hours in the top shared game.", holder: P.leo, prev: P.max,
    };

    out property <FeedCardData> recap: {
        id: "recap_45", card-type: "recap", recap-week: "Week 45", age-label: "Last week",
        recap-seal: { key: "recap:45", sealed: true, seed: 4421, bright: SealedFixtures.recap-bright, dim: SealedFixtures.recap-dim },
        recap-hangout-min: 2592, recap-clips: 31, recap-longest-min: 238,
        game-id: "counter-strike-2", game-name: "Counter-Strike 2", game-capsule: P.cs2, game-has-capsule: true,
        recap-active: { name: "Jonas", initials: "JO", hue: 2, avatar: P.jonas.avatar, has-avatar: true, count: 842 },
        recap-clipped: { name: "Hugo", initials: "HU", hue: 2, avatar: P.hugo.avatar, has-avatar: true, count: 9 },
        belts-moved: [
            { title: "Marathon", title-upper: "MARATHON", stat-line: "Longest single game session.", icon: P.i-marathon, value: "3", unit: "h 52",
              prev-name: "Leo", prev-initials: "LE", prev-hue: 4, prev-avatar: P.leo.avatar, prev-has-avatar: true,
              holder-name: "Sara", holder-initials: "SA", holder-hue: 3, holder-avatar: P.sara.avatar, holder-has-avatar: true,
              belt: P.marathon },
            { title: "The Carry", title-upper: "THE CARRY", stat-line: "Most hours in the top shared game.", icon: P.i-carry, value: "412", unit: "h",
              prev-name: "Max", prev-initials: "MA", prev-hue: 0, prev-avatar: P.max.avatar, prev-has-avatar: true,
              holder-name: "Leo", holder-initials: "LE", holder-hue: 4, holder-avatar: P.leo.avatar, holder-has-avatar: true,
              belt: P.carry },
        ],
        belts-held: [
            { rank: 1, name: "Sara", initials: "SA", hue: 3, avatar: P.sara.avatar, has-avatar: true, count: 3 },
            { rank: 2, name: "Leo", initials: "LE", hue: 4, avatar: P.leo.avatar, has-avatar: true, count: 2 },
            { rank: 3, name: "Jonas", initials: "JO", hue: 2, avatar: P.jonas.avatar, has-avatar: true, count: 1 },
            { rank: 3, name: "b0bben", initials: "B0", hue: 1, avatar: P.bob.avatar, has-avatar: true, count: 1 },
        ],
        recap-games: [
            { game-id: "counter-strike-2", name: "Counter-Strike 2", capsule: P.cs2, has-capsule: true, minutes: 1104 },
            { game-id: "rocket-league", name: "Rocket League", capsule: P.rl, has-capsule: true, minutes: 520 },
            { game-id: "deep-rock-galactic", name: "Deep Rock Galactic", capsule: P.drg, has-capsule: true, minutes: 310 },
            { game-id: "helldivers-2", name: "Helldivers 2", capsule: P.hd2, has-capsule: true, minutes: 122 },
        ],
        recap-games-min: 2056,
        recap-range: "2 to 8 November",
    };

    out property <BeltReveal> owl: {
        key: "night_owl:2203", sealed: false, seed: 2203,
        code: SealedFixtures.carry-code, cells: SealedFixtures.carry-cells,
        title: "Night Owl", icon: P.i-owl, hue-index: P.bob.hue-index, kind: 0, amount: 14, unit: "h",
        stat: "Most hours after midnight.", holder: P.bob, prev: P.jonas,
    };

    /// A week with no belt.
    out property <FeedCardData> no-belts: {
        id: "recap_45", card-type: "recap", recap-week: "Week 45", age-label: "Last week",
        recap-seal: { key: "recap:45", sealed: true, seed: 4421, bright: SealedFixtures.recap-bright, dim: SealedFixtures.recap-dim },
        recap-hangout-min: 2592, recap-clips: 31, recap-longest-min: 238,
        game-id: "counter-strike-2", game-name: "Counter-Strike 2", game-capsule: P.cs2, game-has-capsule: true,
        recap-active: { name: "Jonas", initials: "JO", hue: 2, avatar: P.jonas.avatar, has-avatar: true, count: 842 },
        recap-clipped: { name: "Hugo", initials: "HU", hue: 2, avatar: P.hugo.avatar, has-avatar: true, count: 9 },
        recap-games: [
            { game-id: "counter-strike-2", name: "Counter-Strike 2", capsule: P.cs2, has-capsule: true, minutes: 1104 },
            { game-id: "rocket-league", name: "Rocket League", capsule: P.rl, has-capsule: true, minutes: 520 },
            { game-id: "deep-rock-galactic", name: "Deep Rock Galactic", capsule: P.drg, has-capsule: true, minutes: 310 },
            { game-id: "helldivers-2", name: "Helldivers 2", capsule: P.hd2, has-capsule: true, minutes: 122 },
        ],
        recap-games-min: 2056,
    };

    /// A week with five belts moved and five members with a belt.
    out property <FeedCardData> many-belts: {
        id: "recap_45", card-type: "recap", recap-week: "Week 45", age-label: "Last week",
        recap-seal: { key: "recap:45", sealed: true, seed: 4421, bright: SealedFixtures.recap-bright, dim: SealedFixtures.recap-dim },
        recap-hangout-min: 2592, recap-clips: 31, recap-longest-min: 238,
        game-id: "counter-strike-2", game-name: "Counter-Strike 2", game-capsule: P.cs2, game-has-capsule: true,
        recap-active: { name: "Jonas", initials: "JO", hue: 2, avatar: P.jonas.avatar, has-avatar: true, count: 842 },
        recap-clipped: { name: "Hugo", initials: "HU", hue: 2, avatar: P.hugo.avatar, has-avatar: true, count: 9 },
        belts-moved: [
            { title: "Marathon", title-upper: "MARATHON", stat-line: "Longest single game session.", icon: P.i-marathon, value: "3", unit: "h 52",
              prev-name: "Leo", prev-initials: "LE", prev-hue: 4, prev-avatar: P.leo.avatar, prev-has-avatar: true,
              holder-name: "Sara", holder-initials: "SA", holder-hue: 3, holder-avatar: P.sara.avatar, holder-has-avatar: true,
              belt: P.marathon },
            { title: "The Carry", title-upper: "THE CARRY", stat-line: "Most hours in the top shared game.", icon: P.i-carry, value: "412", unit: "h",
              prev-name: "Max", prev-initials: "MA", prev-hue: 0, prev-avatar: P.max.avatar, prev-has-avatar: true,
              holder-name: "Leo", holder-initials: "LE", holder-hue: 4, holder-avatar: P.leo.avatar, holder-has-avatar: true,
              belt: P.carry },
            { title: "Night Owl", title-upper: "NIGHT OWL", stat-line: "Most hours after midnight.", icon: P.i-owl, value: "14", unit: "h",
              prev-name: "Jonas", prev-initials: "JO", prev-hue: 2, prev-avatar: P.jonas.avatar, prev-has-avatar: true,
              holder-name: "b0bben", holder-initials: "B0", holder-hue: 1, holder-avatar: P.bob.avatar, holder-has-avatar: true,
              belt: P.owl },
            { title: "Marathon", title-upper: "MARATHON", stat-line: "Longest single game session.", icon: P.i-marathon, value: "3", unit: "h 52",
              prev-name: "Leo", prev-initials: "LE", prev-hue: 4, prev-avatar: P.leo.avatar, prev-has-avatar: true,
              holder-name: "Sara", holder-initials: "SA", holder-hue: 3, holder-avatar: P.sara.avatar, holder-has-avatar: true,
              belt: P.marathon },
            { title: "The Carry", title-upper: "THE CARRY", stat-line: "Most hours in the top shared game.", icon: P.i-carry, value: "412", unit: "h",
              prev-name: "Max", prev-initials: "MA", prev-hue: 0, prev-avatar: P.max.avatar, prev-has-avatar: true,
              holder-name: "Leo", holder-initials: "LE", holder-hue: 4, holder-avatar: P.leo.avatar, holder-has-avatar: true,
              belt: P.carry },
        ],
        belts-held: [
            { rank: 1, name: "Sara", initials: "SA", hue: 3, avatar: P.sara.avatar, has-avatar: true, count: 3 },
            { rank: 2, name: "Leo", initials: "LE", hue: 4, avatar: P.leo.avatar, has-avatar: true, count: 2 },
            { rank: 3, name: "Jonas", initials: "JO", hue: 2, avatar: P.jonas.avatar, has-avatar: true, count: 1 },
            { rank: 3, name: "b0bben", initials: "B0", hue: 1, avatar: P.bob.avatar, has-avatar: true, count: 1 },
            { rank: 3, name: "Max", initials: "MA", hue: 0, avatar: P.max.avatar, has-avatar: true, count: 1 },
        ],
        recap-games: [
            { game-id: "counter-strike-2", name: "Counter-Strike 2", capsule: P.cs2, has-capsule: true, minutes: 1104 },
            { game-id: "rocket-league", name: "Rocket League", capsule: P.rl, has-capsule: true, minutes: 520 },
            { game-id: "deep-rock-galactic", name: "Deep Rock Galactic", capsule: P.drg, has-capsule: true, minutes: 310 },
            { game-id: "helldivers-2", name: "Helldivers 2", capsule: P.hd2, has-capsule: true, minutes: 122 },
        ],
        recap-games-min: 2056,
    };

    /// A first week: the numbers and one game.
    out property <FeedCardData> bare: {
        id: "recap_45", card-type: "recap", recap-week: "Week 1", age-label: "Last week",
        recap-seal: { key: "recap:45", sealed: true, seed: 4421, bright: SealedFixtures.recap-bright, dim: SealedFixtures.recap-dim },
        recap-hangout-min: 96, recap-clips: 2,
        recap-games: [
            { game-id: "counter-strike-2", name: "Counter-Strike 2", capsule: P.cs2, has-capsule: true, minutes: 96 },
        ],
        recap-games-min: 96,
    };

    out property <ZonesData> feed: {
        you: P.bob,
        stage: "card",
        stage-card: { id: "g1", card-type: "clip", clip-kind: "game", is-hero: true, actor-name: "Hugo", actor-initials: "HU",
            actor-avatar: P.hugo.avatar, actor-has-avatar: true, game-name: "Rocket League", duration-human: "0:30" },
        board: "sealed", recap-card: P.recap,
    };
}

/// The feed panel with the recap in the centre view, `at` after the click.
/// The slot is the box of the sealed recap in the feed.
component Panel inherits Rectangle {
    in property <FeedCardData> card: P.recap;
    in property <length> slot-x: 578px;
    in property <length> slot-y: 66px;
    in property <length> slot-w: 267px;
    in property <length> slot-h: 474px;
    in property <duration> at: 2400ms;
    width: 865px;
    height: 865px;
    background: Theme.bg-app;
    init => {
        Clock.manual = true;
        Clock.manual-now = root.at;
        SealedUi.recap-card = root.card;
        SealedUi.from = { x: root.slot-x, y: root.slot-y, w: root.slot-w, h: root.slot-h };
        SealedUi.t0 = 0ms;
        SealedUi.active-key = "recap:45";
        SealedUi.active-slot = "recap";
        SealedUi.active-kind = "recap";
    }
    VerticalLayout {
        CrewFeed { vertical-stretch: 1; zones: P.feed; }
        ControlBar {
            height: Theme.control-bar-height;
            user-name: "b0bben";
            user-initials: "B0";
            user-avatar: P.bob.avatar;
            has-user-avatar: true;
            can-stream: true;
        }
    }
}

/// At rest: the week and the members left, the belts right, the games under.
export component PreviewRevealRecap inherits Panel { }

/// The back at the end of the charge, in the box of its slot.
export component PreviewRevealRecapBack inherits Panel { at: 850ms; }

/// A week with no belt: the games stand in the right column, two in a row.
export component PreviewRevealRecapNoBelts inherits Panel { card: P.no-belts; }

/// A week with five belts moved: three rows and "+2 MORE".
export component PreviewRevealRecapManyBelts inherits Panel { card: P.many-belts; }

/// A first week: the numbers and one game, no members, no belts.
export component PreviewRevealRecapBare inherits Panel { card: P.bare; }
