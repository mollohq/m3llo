                            { user-id: "u-bobdev", name: "bobdev", initials: "BO", color-index: 0, state: "due", due-minutes: 27 },
                            { user-id: "u-owe", name: "oweboweob", initials: "OW", color-index: 1, state: "none" },
                            { user-id: "u-sannah", name: "sannah", initials: "SA", color-index: 3, state: "no" },
                        ],
                        more-in: 12, no-count: 8,
                    };
                }
                LookingToPlayCard {
                    data: {
                        ask-id: "a2", state: "on", asker-name: "xX_Night_Owl_Sniper_Xx2", viewer-answer: "in_15",
                        rows: [
                            { user-id: "u-long", name: "xX_Night_Owl_Sniper_Xx2", initials: "XX", color-index: 4, state: "in" },
                        ],
                    };
                }
                LookingToPlayCard {
                    data: {
                        ask-id: "a3", state: "closed", closed-reason: "done", asker-name: "xX_Night_Owl_Sniper_Xx2",
                        closed-at: "Di. 20:02",
                        was-in: [
                            { user-id: "u-long", name: "xX_Night_Owl_Sniper_Xx2", initials: "XX", color-index: 4 },
                            LtpMockPreview.owe, LtpMockPreview.k0ji, LtpMockPreview.vilse, LtpMockPreview.morran, LtpMockPreview.frasse, LtpMockPreview.sannah,
                        ],
                    };
                }
            }
        }
        VerticalLayout {
            padding-top: 16px;
            alignment: start;
            LookingToPlayToast {
                data: {
                    ask-id: "a1", crew-name: "The Midnight Respawn Society", crew-initials: "MR", crew-color-index: 2,
                    asker-name: "xX_Night_Owl_Sniper_Xx2", minutes-left: 28, count-in: 14,
                    has-game: true, game-id: "steam-489830", game-name: "The Elder Scrolls V: Skyrim Special Edition",
                    game-monogram: "TES", game-hue: 3,
                };
            }
        }
    }
}
