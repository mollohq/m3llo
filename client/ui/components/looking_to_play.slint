/// The toast in its place over a window (frame 5): the top right corner,
/// 16px in, over the content, with no scrim. `main.slint` mounts it so.
export component PreviewToastInWindow inherits Rectangle {
    width: 980px;
    height: 560px;
    background: Theme.bg-app;
    HorizontalLayout {
        Rectangle {
            width: 200px;
            background: Theme.surface;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                alignment: start;
                LtpStub { share: 0.6; }
                LtpStub { }
                LtpStub { share: 0.8; }
                LtpStub { share: 0.5; }
            }
        }
        Rectangle { width: 1px; background: Theme.card-border; }
        Rectangle {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                alignment: start;
                Rectangle { height: 64px; background: Theme.surface; }
                Rectangle { height: 64px; background: Theme.surface; }
                Rectangle { height: 64px; background: Theme.surface; }
            }
        }
        Rectangle { width: 1px; background: Theme.card-border; }
        Rectangle {
            width: 300px;
            background: Theme.surface;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                alignment: end;
                LtpStub { share: 0.4; }
                LtpStub { }
                LtpStub { share: 0.7; }
                LtpStub { share: 0.55; }
            }
        }
    }
    LookingToPlayToast {
        x: parent.width - self.width - 16px;
        y: 16px;
        height: self.preferred-height;
        data: {
            ask-id: "a1", crew-name: "Night Shift", crew-initials: "NS", crew-color-index: 1,
            asker-name: "k0ji", minutes-left: 28, count-in: 2,
            has-game: true, game-id: "steam-730", game-name: "Counter-Strike 2", game-monogram: "CS", game-hue: 0,
            game-icon: LtpMockPreview.cs2, has-game-icon: true,
        };
    }
}

/// Long text: a 24 character name, a long game, German-length labels, in
