    HorizontalLayout {
        alignment: start;
        spacing: 16px;
        Rectangle {
            width: 340px;
            background: Theme.surface;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                alignment: start;
                LookingToPlayCard {
                    data: {
                        ask-id: "a1", state: "open", asker-name: "xX_Night_Owl_Sniper_Xx2", minutes-left: 28,
                        has-game: true, game-id: "steam-489830", game-name: "The Elder Scrolls V: Skyrim Special Edition",
