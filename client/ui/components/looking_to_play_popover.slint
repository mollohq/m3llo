}

/// The member list longer than the room: it scrolls inside 420px. Long
/// names, a long game, German-length labels, an error line, busy.
export component PreviewPopoverLong inherits Rectangle {
    width: 740px;
    height: 520px;
    background: Theme.surface;
    HorizontalLayout {
        padding: 16px;
        spacing: 16px;
        alignment: start;
        VerticalLayout {
            width: 340px;
            alignment: end;
            LookingToPlayPopover {
                large-crew: true;
                crew-initials: "MR";
                crew-color-index: 2;
                member-count: 49;
                picked-count: 2;
                error-text: "Das hat nicht geklappt. Bitte versuche es gleich noch einmal.";
                groups: [
                    {
                        index: 0, label: "Letztes Mal", picked: false, more: 4,
                        faces: [
                            { initials: "K0", color-index: 2 },
                            { initials: "OW", color-index: 1 },
                            { initials: "FR", color-index: 4 },
                        ],
                    },
                ];
                members: [
                    { user-id: "u-long", name: "xX_Night_Owl_Sniper_Xx2", initials: "XX", color-index: 4, doing: "The Elder Scrolls V: Skyrim Special Edition, 2 h 10", picked: true },
                    { user-id: "u-sannah", name: "sannah", initials: "SA", color-index: 3, doing: "Im Sprachkanal", picked: true },
                    { user-id: "u-vilse", name: "vilse", initials: "VI", color-index: 0 },
                    { user-id: "u-morran", name: "morran", initials: "MO", color-index: 2, doing: "Counter-Strike 2, 12 min" },
                    { user-id: "u-k0ji", name: "k0ji", initials: "K0", color-index: 2 },
                    { user-id: "u-frasse", name: "frasse", initials: "FR", color-index: 4 },
                ];
                games: [
                    { game-id: "steam-489830", name: "The Elder Scrolls V: Skyrim Special Edition", monogram: "TES", hue: 3, selected: true },
                    { game-id: "steam-548430", name: "Deep Rock Galactic", monogram: "DR", hue: 3, icon: LtpPopMock.drg, has-icon: true },
                ];
            }
        }
        VerticalLayout {
            width: 340px;
            alignment: end;
            LookingToPlayPopover {
                crew-initials: "MR";
                crew-color-index: 2;
                picked-count: 0;
                busy: true;
                members: [
                    { user-id: "u-long", name: "xX_Night_Owl_Sniper_Xx2", initials: "XX", color-index: 4, doing: "Im Sprachkanal" },
                ];
            }
        }
    }
}
