    }
    out property <string> menu-check-updates: @tr("Check for Updates…");
    out property <string> menu-preferences: @tr("Preferences…");
    /// {} is the app name.
    pure public function menu-hide(app: string) -> string {
        @tr("Hide {}", app)
    }
