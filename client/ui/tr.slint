    // --- Crew cards in the sidebar (src/handlers/presence.rs) ---

    /// A member streams: {0} is the member, {1} is the stream title.
    pure public function crew-card-streaming-name-title(name: string, title: string) -> string {
        @tr("{0} streaming {1}", name, title)
    }
    /// A member streams with no title. The value is the member.
    pure public function crew-card-streamer-streaming(name: string) -> string {
        @tr("{} streaming", name)
    }
    /// A stream with no streamer name. The value is the stream title.
    pure public function crew-card-streaming-title(title: string) -> string {
        @tr("streaming {}", title)
    }
