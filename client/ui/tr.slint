    out property <string> shortcut-push-to-talk: @tr("Push to talk");
    out property <string> shortcut-clip: @tr("Clip the last moments of voice");

    // --- The overlay over the game (src/hud_overlay/renderer.rs, the hud
    //     process) ---

    /// The badge of a live stream.
    out property <string> hud-live: @tr("LIVE");
