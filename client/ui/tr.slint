    // --- OS notifications (src/notifications.rs, src/stream_key.rs) ---

    /// The window closed to the tray. {} is the app name.
    pure public function notice-tray-title(app: string) -> string {
        @tr("{} is still running", app)
    }
    /// Windows and Linux: where the app is now.
    out property <string> notice-tray-body: @tr("It stays in the tray to keep collecting your gaming stats. Right-click the tray icon to quit.");
    /// macOS: where the app is now.
    out property <string> notice-tray-body-macos: @tr("It stays in the menu bar to keep collecting your gaming stats. Quit it from the menu bar icon.");
    /// The title of a notification about the stream key.
    out property <string> notice-stream-title: @tr("noun" => "Stream");
    /// The stream key started a stream, and the stream is live.
    out property <string> notice-stream-live: @tr("You are live");
    /// The stream key ended the stream.
    out property <string> notice-stream-ended: @tr("Stream ended");
    /// The stream that the stream key started did not start.
    out property <string> notice-stream-failed: @tr("Stream failed");
    /// The stream key found no active crew.
    out property <string> notice-stream-no-crew: @tr("Pick a crew to stream to");
    /// The stream key found no detected game.
    out property <string> notice-stream-no-game: @tr("No game to stream");
    /// The title of a notification about a member of the crew.
    out property <string> notice-crew-title: @tr("Crew");
    /// A member joined the voice channel. {} is the member.
    pure public function notice-member-joined(name: string) -> string {
        @tr("{} jumped in", name)
    }
    /// A chat message: {0} is the sender, {1} is the start of the message.
    pure public function notice-message(sender: string, preview: string) -> string {
        // {0} is the sender, {1} is the message.
        @tr("format" => "{0}: {1}", sender, preview)
    }
    /// The title of an invite notification. {} is the app name.
    pure public function notice-invite-title(app: string) -> string {
        @tr("{} invite", app)
    }
    /// An invite: {0} is the person who invites, {1} is the crew.
    pure public function notice-invite-body(inviter: string, crew: string) -> string {
        @tr("{0} invited you to {1}", inviter, crew)
    }

