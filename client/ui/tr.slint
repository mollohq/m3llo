    out property <string> stream-ended-lost-on-server: @tr("The server lost the stream during a reconnect.");
    out property <string> stream-ended-host-left: @tr("The host ended the stream.");
    out property <string> stream-ended: @tr("The stream ended.");
    /// The names of the stream quality presets, as the quality buttons show
    /// them.
    out property <string> quality-ultra: @tr("ULTRA");
    out property <string> quality-high: @tr("HIGH");
    out property <string> quality-medium: @tr("MEDIUM");
    out property <string> quality-pro-potato: @tr("PRO-POTATO");
    out property <string> quality-potato: @tr("POTATO");

    // --- Feed zones: the board and the people (src/handlers/zones.rs) ---

    /// The labels of the numbers on the board, in upper case.
    out property <string> stat-label-hangout: @tr("HANGOUT");
    out property <string> stat-label-clips: @tr("CLIPS");
    out property <string> stat-label-sessions: @tr("SESSIONS");
    /// The members who were on today.
    out property <string> stat-label-on: @tr("ON");
    out property <string> stat-label-longest: @tr("LONGEST");
    out property <string> stat-label-games: @tr("GAMES");
    out property <string> stat-label-clips-and-streams: @tr("CLIPS AND STREAMS");
    /// The board of a week with no crew time.
    out property <string> zones-quiet-line: @tr("No crew time last week.");
    /// The members who played in a quiet week. The value is a list of names.
    pure public function zones-still-played(names: string) -> string {
        @tr("{} still played.", names)
    }
    /// The board of a dormant crew. The value is a date ("Nothing new since
    /// 2 October.").
    pure public function zones-nothing-new(date: string) -> string {
        @tr("Nothing new since {}.", date)
    }
    /// The board of a dormant crew with the first title: {0} is a date, {1}
    /// is the member, {2} is the title ("Nothing new since 2 October. Bob
    /// holds Night Owl.").
    pure public function zones-nothing-new-holds(date: string, name: string, title: string) -> string {
        @tr("Nothing new since {0}. {1} holds {2}.", date, name, title)
    }
    /// The titles that the board does not show ("+3 MORE").
    pure public function zones-more-upper(n: int) -> string {
        @tr("+{} MORE", n)
    }
    /// The members in the voice call ("3 in the call").
    pure public function zones-in-call(n: int) -> string {
        @tr("{n} in the call" | "{n} in the call" % n)
    }
    /// The voice channel has nobody in it.
    out property <string> zones-voice-empty: @tr("Empty");
    /// The voice channel has nobody in it. The value is the date of the last
    /// call ("Empty. Last call 6 November").
    pure public function zones-voice-empty-last-call(date: string) -> string {
        @tr("Empty. Last call {}", date)
    }

    // --- Voice (src/handlers/voice.rs) ---

    /// The saved microphone or speaker is gone, and the app uses the system
    /// default.
    out property <string> audio-device-fallback: @tr("Your saved audio device was not found. Switched to system default — you can change it in Settings.");

    // --- Say hi: the greeting that a joined card sends to the crew chat
    //     (src/say_hi.rs) ---
    //
    // The value is the mention of the new member ("@Sara"). Keep it as it is:
    // the chat finds the member by it. Plain words, no exclamation marks.

    pure public function say-hi-made-it(mention: string) -> string {
        @tr("{} made it. Welcome to the crew.", mention)
    }
    pure public function say-hi-is-in(mention: string) -> string {
        @tr("{} is in. Grab a seat.", mention)
    }
    pure public function say-hi-showed-up(mention: string) -> string {
        @tr("Look who showed up. Hey {}.", mention)
    }
    pure public function say-hi-found-us(mention: string) -> string {
        @tr("{}, you found us. Good.", mention)
    }
    pure public function say-hi-new-blood(mention: string) -> string {
        @tr("New blood. Welcome {}.", mention)
    }
    pure public function say-hi-is-here(mention: string) -> string {
        @tr("{} is here. Mic on, let's go.", mention)
    }

    // --- Game clips: the toasts over the game and the clip player
    //     (src/game_clip.rs, src/clip_key.rs, src/game_clip_player.rs) ---

    out property <string> clip-toast-saved: @tr("Game clip saved");
    /// The clip key made no game clip.
    out property <string> clip-toast-none: @tr("No game clip");
    /// Why the replay cannot clip.
    out property <string> clip-toast-disk-low: @tr("Game clips are off: the disk is almost full");
    out property <string> clip-toast-unavailable: @tr("Clips are not available for this game");
    /// macOS: the app needs the Screen Recording permission.
    out property <string> clip-toast-no-permission: @tr("Allow Screen Recording in Settings to clip your game");
    /// The clip key saved the voice only, and the replay cannot clip.
    out property <string> clip-toast-voice-disk-low: @tr("Voice clip saved. Game clips are off: the disk is almost full");
    out property <string> clip-toast-voice-unavailable: @tr("Voice clip saved. Clips are not available for this game");
    out property <string> clip-toast-voice-no-permission: @tr("Voice clip saved. Allow Screen Recording in Settings to clip your game");
    /// The clip player cannot play while the user watches a stream.
    out property <string> clip-player-watching: @tr("Stop watching the stream to play a clip");

    // --- Game stats: the You strip and the You view (src/handlers/stats.rs) ---

    /// A game that the app cannot name.
    out property <string> unknown-game: @tr("Unknown game");
    /// A match record with letters: {0} is the wins, {1} is the losses, {2}
    /// is the draws ("12W 5L 2D").
    pure public function record-w-l-d(wins: int, losses: int, draws: int) -> string {
        @tr("{0}W {1}L {2}D", wins, losses, draws)
    }
    /// The longest run of wins ("W6 best").
    pure public function streak-best(n: int) -> string {
        @tr("W{} best", n)
    }
    /// The longest run of losses ("L3 worst").
    pure public function streak-worst(n: int) -> string {
        @tr("L{} worst", n)
    }

    // --- Settings: Keybinds and Game clips (src/callbacks/settings.rs) ---

    /// The key that the user pressed is the push-to-talk key already. {} is
    /// the key ("F8").
    pure public function key-taken-by-ptt(key: string) -> string {
        @tr("Push-to-talk uses {}. Pick another key.", key)
    }
    /// The key that the user pressed is the clip key already. {} is the key.
    pure public function key-taken-by-clip(key: string) -> string {
        @tr("Clip uses {}. Pick another key.", key)
    }
    /// The key that the user pressed is the stream key already. {} is the key.
    pure public function key-taken-by-stream-key(key: string) -> string {
        @tr("Stream key uses {}. Pick another key.", key)
    }
    /// A quality of the game clips: {0} is the height of the picture in
    /// pixels, {1} is the frames per second ("1080p, 60 fps").
    pure public function game-clip-quality(height: int, fps: int) -> string {
        @tr("{0}p, {1} fps", height, fps)
    }

    // --- Settings: the language of the General tab (src/callbacks/settings.rs) ---

    /// The first choice of the Language dropdown: m3llo uses the language of
    /// the operating system. The other choices are language names in their
    /// own script, which are not translated.
    out property <string> language-system: @tr("System");

    // --- File dialogs (src/callbacks/*.rs) ---

    /// The name of the file type filter in a dialog that picks an image.
    out property <string> file-filter-images: @tr("Images");

    // --- The image viewer of the chat (src/callbacks/chat.rs) ---

    /// The size of an image in pixels: {0} is the width, {1} is the height
    /// ("1920×1080").
    pure public function image-dimensions(width: int, height: int) -> string {
        // {0} is the width, {1} is the height.
        @tr("format" => "{0}×{1}", width, height)
    }

    // --- Sign in, links and onboarding: the failures that the core reports
    //     (src/handlers/auth.rs) ---

    /// The user cancelled the sign-in at the provider. {} is the provider
    /// ("Discord").
    pure public function auth-cancelled(provider: string) -> string {
        @tr("You cancelled the {} sign-in.", provider)
    }
    /// The sign-in at a provider failed: {0} is the provider, {1} is the
    /// error text of the sign-in flow (English).
    pure public function auth-provider-failed(provider: string, detail: string) -> string {
        @tr("{0} sign-in failed: {1}", provider, detail)
    }
    /// The sign-in at a provider stopped with no result. {} is the provider.
    pure public function auth-unexpected(provider: string) -> string {
        @tr("{} sign-in failed unexpectedly", provider)
    }
    /// This build has no sign-in for the provider. {} is the provider.
    pure public function auth-not-configured(provider: string) -> string {
        @tr("{} login not configured", provider)
    }
    /// The provider has no sign-in on this platform. {} is the provider
    /// ("Apple").
    pure public function auth-not-available(provider: string) -> string {
        @tr("{} sign-in isn't available here", provider)
    }
    /// The provider gave no token. {} is the provider.
    pure public function auth-no-token(provider: string) -> string {
        @tr("{} sign-in returned no token", provider)
    }
    /// The realtime connection failed after the sign-in. {} is the error
    /// text (English).
    pure public function auth-socket-failed(detail: string) -> string {
        @tr("WebSocket failed: {}", detail)
    }
    /// Onboarding: the account was not made.
    out property <string> onboarding-account-failed: @tr("Couldn't create your account. Check your connection and try again.");
    /// Onboarding: the app did not connect.
    out property <string> onboarding-connect-failed: @tr("Couldn't connect. Check your connection and try again.");
    /// Onboarding: the new crew was not made.
    out property <string> onboarding-crew-create-failed: @tr("Couldn't create the crew. Try again.");
    /// Onboarding: the chosen crew was not joined, and why.
    out property <string> onboarding-crew-full: @tr("That crew is full. Pick another one.");
    out property <string> onboarding-crew-gone: @tr("That crew no longer exists. Pick another one.");
    out property <string> onboarding-crew-not-allowed: @tr("You can't join that crew. Pick another one.");
    out property <string> onboarding-crew-join-failed: @tr("Couldn't join the crew. Check your connection and try again.");

    // --- Protocol versions: the update banner (src/handlers/mod.rs) ---

    /// The app is too old for the server: {0} is the protocol version that
    /// the server needs, {1} is the version of the app.
    pure public function protocol-client-outdated(required: int, actual: int) -> string {
        @tr("Server requires protocol {0} but client speaks {1}. Please update m3llo.", required, actual)
    }
    /// The server is too old for the app: {0} is the protocol version that
    /// the app needs, {1} is the version of the server.
    pure public function protocol-server-outdated(required: int, actual: int) -> string {
        @tr("Client requires server protocol {0} but server speaks {1}. Server needs updating.", required, actual)
    }

    // --- Streams: why a start or a watch failed, and the sources of the
    //     stream picker (src/handlers/streaming.rs) ---

    out property <string> stream-failed-not-signed-in: @tr("You are not signed in.");
    out property <string> stream-failed-server-unavailable: @tr("Streaming is not available on the server right now.");
    out property <string> stream-failed-server-no-answer: @tr("The server did not answer the stream start.");
    out property <string> stream-failed-server-refused: @tr("The server did not accept the stream.");
    out property <string> stream-failed-unreachable: @tr("Could not reach the stream server.");
    out property <string> stream-failed-no-encoder: @tr("Streaming requires a hardware encoder (NVIDIA, AMD, or Intel). None was found on this machine.");
    out property <string> stream-failed-engine-off: @tr("The media engine is not running.");
    out property <string> stream-failed-no-session: @tr("The stream has no session to join.");
    out property <string> stream-failed-decoder: @tr("The video decoder did not start.");
    out property <string> stream-failed-unavailable: @tr("The stream is not available.");
    /// A monitor in the stream picker. {} is its number ("Display 2").
    pure public function stream-source-display(n: int) -> string {
        @tr("Display {}", n)
    }
    /// The primary monitor in the stream picker. {} is its number.
    pure public function stream-source-display-primary(n: int) -> string {
        @tr("Display {} (Primary)", n)
    }

    // --- Crew gifts: the pickers (src/callbacks/quests.rs) ---

    /// The server did not answer a gift change.
    out property <string> gift-no-answer: @tr("The server did not answer.");

    // --- Server error codes: an RPC error that the user sees is a stable
    //     code from the server (NAME_TAKEN). Rust maps each code to one
    //     member (src/callbacks/quests.rs, src/handlers/games.rs). ---

    /// A server error with no message of its own: an unknown code, or an
    /// old server that sends no code.
    out property <string> server-error-generic: @tr("Something went wrong. Try again.");
    /// A crew banner upload is not a JPEG image.
    out property <string> gift-error-banner-not-jpeg: @tr("A banner is a JPEG.");
    /// A crew banner image is larger than the server takes.
    out property <string> gift-error-banner-too-large: @tr("Banner too large.");
    /// Only the crew owner can change the crew banner.
    out property <string> gift-error-owner-only-banner: @tr("Only the owner sets the banner.");
    /// Only the crew owner can change the custom invite link.
    out property <string> gift-error-owner-only-link: @tr("Only the owner sets the invite link.");
    /// The crew has not unlocked this gift with its quests yet.
    out property <string> gift-error-locked: @tr("Gift not unlocked.");
    /// The invite link name is reserved or has a wrong form.
    out property <string> gift-error-name-not-allowed: @tr("Name not allowed.");
    /// Another crew has the invite link name, or the crew has an emoji
    /// with the name.
    out property <string> gift-error-name-taken: @tr("Name taken.");
    /// A crew emoji image is not a JPEG, PNG or GIF.
    out property <string> gift-error-image-type: @tr("Unsupported image type.");
    /// A crew emoji image is larger than the server takes.
    out property <string> gift-error-emoji-too-large: @tr("Emoji too large.");
    /// The user is not a member of the crew any more.
    out property <string> gift-error-not-a-member: @tr("Not a crew member.");
    /// The crew has used all of its emoji slots.
    out property <string> gift-error-no-free-emoji-slot: @tr("No free emoji slot.");
    /// The rule for a crew emoji name. Keep the numbers 2 and 24.
    out property <string> gift-error-emoji-name-invalid: @tr("Name is 2 to 24 letters, digits or underscores.");
    /// Only the member who added an emoji, or the crew owner, can remove it.
    out property <string> gift-error-emoji-remove-forbidden: @tr("Only the adder or the owner removes an emoji.");
    /// The crew has no emoji with this name.
    out property <string> gift-error-emoji-not-found: @tr("No such emoji.");
    /// The server has no Riot API key, so a Riot account cannot be linked.
    out property <string> riot-error-not-configured: @tr("Riot linking is not available right now.");
    /// The server could not reach the Riot API.
    out property <string> riot-error-unreachable: @tr("Could not reach Riot. Try again.");
    /// The Riot API refused too many requests.
    out property <string> riot-error-rate-limited: @tr("Riot is busy. Try again in a minute.");
    /// The Riot API sent an error.
    out property <string> riot-error-api: @tr("Riot sent an error. Try again.");

    // --- Game clips: the clip player (src/game_clip_player.rs) ---

    out property <string> clip-player-engine-off: @tr("The media engine is not running");
    out property <string> clip-player-load-failed: @tr("The clip does not load");
    out property <string> clip-player-play-failed: @tr("The clip does not play");

    // --- The tray menu (src/platform/mod.rs, src/platform/linux_tray.rs) ---

    /// {} is the app name.
    pure public function tray-open(app: string) -> string {
        @tr("Open {}", app)
    }
    out property <string> tray-mute: @tr("Mute");
    out property <string> tray-leave-voice: @tr("Leave Voice");
    /// {} is the app name. The macOS app menu uses it too.
    pure public function tray-quit(app: string) -> string {
        @tr("Quit {}", app)
    }

