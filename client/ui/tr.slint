    out property <string> feed-played-a-game: @tr("Played a game");
    /// The title of a game session: {0} is the names, {1} is the game.
    pure public function feed-names-played(names: string, game: string) -> string {
        @tr("{0} played {1}", names, game)
    }
    /// The title of a game session with no game name. The value is the names.
    pure public function feed-names-played-a-game(names: string) -> string {
        @tr("{} played a game", names)
    }
    /// A match record and a streak: {0} is the record, {1} is the streak
    /// ("4W–2L, 3-win streak").
    pure public function feed-record-streak(record: string, streak: string) -> string {
        // {0} is the record, {1} is the streak.
        @tr("format" => "{0}, {1}", record, streak)
    }
    /// The wins in a row after a session ("3-win streak").
    pure public function feed-win-streak(n: int) -> string {
        @tr("{n}-win streak" | "{n}-win streak" % n)
    }
    /// The losses in a row after a session ("3-loss skid").
    pure public function feed-loss-skid(n: int) -> string {
        @tr("{n}-loss skid" | "{n}-loss skid" % n)
    }
    /// A match record with letters: {0} is the wins, {1} is the losses
    /// ("12W 5L").
    pure public function record-w-l(wins: int, losses: int) -> string {
        @tr("{0}W {1}L", wins, losses)
    }
    /// A match record with a dash: {0} is the wins, {1} is the losses
    /// ("4W–2L").
    pure public function record-dash-w-l(wins: int, losses: int) -> string {
        @tr("{0}W–{1}L", wins, losses)
    }
    /// A match record with a dash: {0} is the wins, {1} is the losses, {2}
    /// is the draws ("4W–2L–1D").
    pure public function record-dash-w-l-d(wins: int, losses: int, draws: int) -> string {
        @tr("{0}W–{1}L–{2}D", wins, losses, draws)
    }
    /// The wins in a row, short ("W4").
    pure public function streak-wins(n: int) -> string {
        @tr("streak" => "W{}", n)
    }
    /// The losses in a row, short ("L2").
    pure public function streak-losses(n: int) -> string {
        @tr("streak" => "L{}", n)
    }
    /// The matches of a recap week ("312 matches").
    pure public function matches(n: int) -> string {
        @tr("{n} match" | "{n} matches" % n)
    }
    /// The matches of a recap week and the games: {0} is a list of games
    /// ("312 matches · CS2, Rocket League").
    pure public function matches-in-games(n: int, games: string) -> string {
        @tr("{n} match · {0}" | "{n} matches · {0}" % n, games)
    }
    /// The kind of a clip: voice.
    out property <string> clip-kind-voice: @tr("noun" => "voice");
    /// The kind of a clip: game.
    out property <string> clip-kind-game: @tr("noun" => "game");

    // The names of the game awards of a weekly recap. The detail under the
    // name is `matches`, `feed-win-streak` or `feed-loss-skid`.

    /// The award of the member with the most matches of the week.
    out property <string> award-grinder: @tr("Grinder of the week");
    /// The award of the member with the longest run of wins of the week.
    out property <string> award-heater: @tr("Biggest heater");
    /// The award of the member with the longest run of losses of the week.
    out property <string> award-skid: @tr("Roughest patch");

    // --- Joined cards (src/joined_line.rs) ---

    /// A member joined the crew. The value is the name ("Jonas joined").
