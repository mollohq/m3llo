    out property <string> menu-redo: @tr("Redo");
    out property <string> menu-cut: @tr("Cut");
    out property <string> menu-copy: @tr("Copy");
    out property <string> menu-paste: @tr("Paste");
    out property <string> menu-select-all: @tr("Select All");
    out property <string> menu-find: @tr("Find…");
